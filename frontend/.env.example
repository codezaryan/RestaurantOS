    # Frontend Environment Variables for RestaurantOS
# Copy this file to .env and adjust values as needed.

# VITE_API_URL: Base URL for the Backend API
#
# Local Development (Vite dev server with proxy):
#   VITE_API_URL=/api
#   The Vite dev server proxies /api/* to http://localhost:5000 (see vite.config.ts)
#
# Docker Compose Deployment (with nginx reverse proxy):
#   VITE_API_URL=/api
#   nginx.conf proxies /api/* to http://backend:5000/api/ in the Docker network
#
# Render / Cloudflare Pages / Netlify (Static Site - NO proxy):
#   VITE_API_URL=https://your-backend-service.onrender.com/api
#   ⚠️ Static sites have NO reverse proxy. Must use the FULL backend URL.
#   Example: Deploy backend as a Render Web Service, then use its URL.
#
# No trailing slash — the code handles it automatically.
VITE_API_URL=/api

