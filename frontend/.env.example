# Frontend Environment Variables for RestaurantOS
# Copy this file to .env and adjust values as needed.

# VITE_API_URL: Base URL for the Backend API
# - In development with Vite proxy: use '/api' (default) — the Vite dev server proxies /api requests.
# - In Docker/Production: use '/api' — nginx proxy handles routing to backend container.
# - For external/cloud deployments: set the full URL e.g. 'https://api.restaurantos.io/api'
# - No trailing slash — the code handles it automatically.
VITE_API_URL=/api

