# RestaurantOS Backend - Environment Configuration
# =================================================
# Copy this file to .env and update values for your environment.
# For production (Render), set these via Render Dashboard Environment Variables.
# NEVER commit .env to version control.

# Server Port
PORT=5000

# Database Connection String
# Local:    postgresql://postgres:postgrespassword@localhost:5432/restaurant_os
# Render:   postgresql://postgres:...YOUR_INTERNAL_URL.../restaurant_os
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/restaurant_os

# JWT Secret Key (change for production!)
JWT_SECRET=restaurant-os-enterprise-secret-key

# FastAPI AI Service URL
# Local:    http://localhost:8000
# Render:   https://restaurantos-fastapi-service.onrender.com
FASTAPI_URL=http://localhost:8000

