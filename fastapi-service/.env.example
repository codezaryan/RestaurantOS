# RestaurantOS FastAPI Service - Environment Configuration
# ========================================================
# Copy this file to .env and update values for your environment.
# For production (Render), set these via Render Dashboard Environment Variables.
# NEVER commit .env to version control.

# Backend Node.js API URL (must include /api suffix)
# Local:    http://localhost:5000/api
# Render:   https://restaurantos-nodebackend.onrender.com/api
BACKEND_URL=http://localhost:5000/api

